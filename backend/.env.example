PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:password@localhost:5432/flatmate_finder_app
AI_MODE=local
# Optional Gemini semantic search. Use a newly generated server-side key.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Optional semantic ranking. Never expose this key in the frontend.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
